# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 커밋하지 않는다.

# search_path 첫 번째 스키마(blog_reviewer)에 모든 테이블이 만들어진다.
DATABASE_URL=postgresql+psycopg://<유저>:<비밀번호>@localhost:5932/<DB명>?options=-csearch_path%3Dblog_reviewer,public

ANTHROPIC_API_KEY=<Anthropic API 키>

# 앱 로그인 계정 (이 계정 하나만 들어올 수 있다)
APP_USERNAME=<아이디>
APP_PASSWORD=<비밀번호>
